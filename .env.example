# Copy this file to .env and fill in real values. Never commit .env.

# Supabase — public client, used in the browser and server (src/lib/supabase.ts)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase — server-only, bypasses RLS (src/lib/supabase-admin.ts).
# Get from Supabase dashboard > Project Settings > API > service_role key.
# NEVER expose this to the client or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Logging in with this email grants access to /admin/* (see middleware.ts) —
# there is no separate roles table, admin-ness is just this one email comparison.
ADMIN_EMAIL=admin@example.com

# Resend — transactional email for contact/application/demo-booking
# notifications (see src/lib/email.ts). Get an API key at resend.com.
RESEND_API_KEY=your_resend_api_key_here
# Verified sender identity. Falls back to Resend's shared onboarding@resend.dev
# sender if unset (works before you verify your own domain).
EMAIL_FROM="UnikAcademy <hello@yourdomain.com>"

# Absolute base URL used for OG/metadata tags; defaults to http://localhost:3000 if unset.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
